{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "(gdb) 调试当前 C 文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\embedded\\w64devkit\\bin\\gdb.exe",
            "preLaunchTask": "gcc 编译当前文件",
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
